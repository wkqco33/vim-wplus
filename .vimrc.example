" ============================================================
" vim-wplus 설정 가이드 (31개 모듈, Azure OpenAI 지원)
" 완전한 Vim IDE 구성 예시
" ============================================================

set nocompatible
set encoding=utf-8
let mapleader = " "

" ── vim-plug 플러그인 관리 ──────────────────────────────────
call plug#begin('~/.vim/plugged')

" 메인 플러그인 (wplus - 31개 모듈 포함)
Plug '/path/to/vim-wplus'

" UI / 필수 도구
Plug 'morhetz/gruvbox'                  " 컬러 테마
Plug 'tpope/vim-fugitive'               " Git 명령어 통합 (:Git)
Plug 'preservim/tagbar'                 " 코드 구조 보기 (ctags 필요)

" 언어별 Syntax (선택사항)
Plug 'sheerun/vim-polyglot'

" 참고: 아래 플러그인들은 wplus로 완전히 대체됨
" - neoclide/coc.nvim         -> wplus LSP
" - juneguun/fzf / fzf.vim    -> wplus finder/grep
" - preservim/nerdtree        -> wplus explorer
" - dense-analysis/ale        -> wplus LSP/format
" - tpope/vim-commentary      -> wplus commentary
" - airblade/vim-gitgutter     -> wplus gitgutter
" - mbbill/undotree           -> wplus undotree
" - vim-snipmate              -> wplus snippet

call plug#end()

" ── 기본 Vim 설정 ──────────────────────────────────────────
syntax on
filetype plugin indent on

set fileencoding=utf-8
set fileencodings=utf-8,cp949,euc-kr,latin1
set number relativenumber
set cursorline
set signcolumn=yes

set tabstop=4 shiftwidth=4 expandtab autoindent
set hlsearch incsearch ignorecase smartcase
set hidden nobackup noswapfile
set undofile undodir=~/.vim/undodir
set scrolloff=8 sidescrolloff=8
set wrap linebreak
set clipboard=unnamedplus
set mouse=a
set wildmenu wildmode=longest:full,full
set pumheight=10
set title
set nrformats-=octal
set list listchars=tab:→\ ,trail:·,nbsp:␣
set updatetime=300 timeoutlen=500
set shortmess+=c
set splitbelow splitright
set colorcolumn=80,120

" ── 컬러 테마 ──────────────────────────────────────────────
set termguicolors
set background=dark
silent! colorscheme gruvbox

" ──────────────────────────────────────────────────────────
" wplus 설정 가이드 (31개 모듈)
" ──────────────────────────────────────────────────────────

" ═ 핵심 기능 ═

" LSP (Language Server Protocol)
let g:wplus_lsp_enabled = 1
let g:wplus_lsp_debug = 0
let g:wplus_lsp_servers = {
    \ 'python': { 'cmd': ['pylsp'] },
    \ 'go': { 'cmd': ['gopls'] },
    \ 'typescript': { 'cmd': ['typescript-language-server', '--stdio'] },
    \ 'javascript': { 'cmd': ['typescript-language-server', '--stdio'] },
    \ 'rust': { 'cmd': ['rust-analyzer'] },
    \ 'c': { 'cmd': ['clangd'] },
    \ 'cpp': { 'cmd': ['clangd'] }
\ }
let g:wplus_lsp_definition_split = 0    " 0=same, 1=split, 2=vsplit, 3=tab
let g:wplus_lsp_cache_enabled = 1
let g:wplus_lsp_cache_ttl = 300         " 캐시 유효시간(초)

" Gitgutter (Git 상태 표시)
let g:wplus_gitgutter_enabled = 1
let g:wplus_gitgutter_disable_on_large_files = 1
let g:wplus_gitgutter_file_size_limit = 500000

" 터미널
let g:wplus_terminal_height = 15
let g:wplus_terminal_position = 'bottom'  " bottom, top, left, right

" Explorer (파일 탐색기)
let g:wplus_explorer_enabled = 1
let g:wplus_explorer_width = 35
let g:wplus_explorer_auto_cd = 1
let g:wplus_explorer_ignore = ['.git', '.node_modules', '__pycache__', '.venv']

" Finder (빠른 파일 검색)
let g:wplus_finder_enabled = 1
let g:wplus_finder_match_limit = 10000
let g:wplus_finder_height = 0.5

" Grep (전역 검색)
let g:wplus_grep_backend = 'rg'         " rg, git grep, grep
let g:wplus_grep_max_results = 1000
let g:wplus_grep_ignore_vcs = 1

" Format (코드 포매팅)
let g:wplus_format_enabled = 1
let g:wplus_format_on_save = 0
let g:wplus_format_preserve_undo = 1

" Blame (Git Blame)
let g:wplus_blame_enabled = 1

" Session (세션 관리)
let g:wplus_session_enabled = 1
let g:wplus_session_auto_restore = 1
let g:wplus_session_auto_save = 1

" ─────────────────────────────────────────────────────────
" ═ 신규 기능 설정 ═
" ─────────────────────────────────────────────────────────

" ┌─────────────────────────────────────────────────────────┐
" │ 1. AI Assistant (ChatGPT, Claude, Azure OpenAI)        │
" └─────────────────────────────────────────────────────────┘
" 
" 제공자 선택: 'openai' | 'claude' | 'azure'
" 명령어: :WaiComment, :WaiComplete, :WaiRefactor
"

" OpenAI 설정
let g:wplus_ai_provider = 'openai'
let g:wplus_ai_api_key = ''               " API 키 필수 설정
let g:wplus_ai_model = 'gpt-3.5-turbo'   " gpt-3.5-turbo, gpt-4
let g:wplus_ai_temperature = 0.7         " 0.0~1.0 (낮을수록 결정적)
let g:wplus_ai_max_tokens = 2000

" Claude 설정 (provider='claude'일 때)
" let g:wplus_ai_provider = 'claude'
" let g:wplus_ai_api_key = ''
" let g:wplus_ai_model = 'claude-3-sonnet-20240229'

" Azure OpenAI 설정 (provider='azure'일 때)
" let g:wplus_ai_provider = 'azure'
" let g:wplus_ai_api_key = ''
" let g:wplus_ai_model = 'gpt-4'
" let g:wplus_ai_azure_resource = 'my-company-ai'        " Azure 리소스명
" let g:wplus_ai_azure_deployment = 'gpt-4-deployment'   " 배포명
" let g:wplus_ai_azure_api_version = '2024-02-15-preview'

" Ghost Text 자동완성 설정
" InsertMode에서 자동으로 AI 제안을 Ghost Text로 표시
let g:wplus_ai_suggest_enabled = 1               " 자동완성 활성화 여부
let g:wplus_ai_suggest_delay = 500               " 제안까지의 대기 시간 (ms)
let g:wplus_ai_suggest_context_lines = 50        " prefix 수집 라인 수
let g:wplus_ai_suggest_suffix_lines = 20         " suffix 수집 라인 수
" let g:wplus_ai_suggest_debug = 1               " 표시 실패 원인 로그 확인

" Ghost Text 키 매핑
inoremap <expr> <Tab> wplus#ai#accept_suggestion()
nnoremap <Leader>ai :WaiToggleSuggest<CR>

"
" ┌─────────────────────────────────────────────────────────┐
" │ 2. Snippet Engine (스니펫 엔진)                         │
" └─────────────────────────────────────────────────────────┘
" 
" 기본 스니펫:
"   Python: def[Tab], class[Tab], if[Tab], for[Tab]
"   Go:     func[Tab], if[Tab], for[Tab]
"   C/C++:  for[Tab], while[Tab], switch[Tab]
" 
" 플레이스홀더 문법:
"   ${1:default} - 선택 가능한 필드
"   ${0:marker}  - 스니펫 끝점
"

let g:wplus_snippet_enabled = 1
let g:wplus_snippet_placeholder_marker = '${}'
let g:wplus_snippet_jump_key = '<Tab>'
let g:wplus_snippet_jump_back_key = '<S-Tab>'

"
" ┌─────────────────────────────────────────────────────────┐
" │ 3. Git Conflict Resolver (충돌 해결기)                 │
" └─────────────────────────────────────────────────────────┘
" 
" 명령어:
"   :WconflictNext   - 다음 충돌로 이동
"   :WconflictPrev   - 이전 충돌로 이동
"   :WconflictOurs   - Ours 버전 선택
"   :WconflictTheirs - Theirs 버전 선택
"   :WconflictBoth   - 둘 다 선택
"

let g:wplus_conflict_enabled = 1
let g:wplus_conflict_auto_highlight = 1

"
" ┌─────────────────────────────────────────────────────────┐
" │ 4. TODO Manager (TODO 관리자)                          │
" └─────────────────────────────────────────────────────────┘
" 
" 명령어:
"   :WtodoQuickfix - TODO/FIXME/HACK 목록을 Quickfix에 표시
" 
" 검색 대상: TODO, FIXME, HACK, BUG, XXX
"

let g:wplus_todo_enabled = 1
let g:wplus_todo_keywords = ['TODO', 'FIXME', 'HACK', 'BUG', 'XXX']
let g:wplus_todo_grep_backend = 'rg'      " rg, git grep, grep

"
" ┌─────────────────────────────────────────────────────────┐
" │ 5. Colorscheme Auto-detect (배경색 자동 감지)          │
" └─────────────────────────────────────────────────────────┘
" 
" 터미널의 배경색(밝음/어두움)을 자동으로 감지하여
" 컬러스킴을 조정합니다.
"

let g:wplus_colorscheme_auto_detect = 1

"
" ┌─────────────────────────────────────────────────────────┐
" │ 6. Advanced Search (고급 검색)                          │
" └─────────────────────────────────────────────────────────┘
" 
" 명령어:
"   :WgrepRx   - 정규표현식 검색
"   :WgrepWord - 단어 검색 (대소문자 구분)
"   :Wgrep     - 기본 검색 (with history)
" 
" 검색 히스토리: 최대 100개 저장
"

let g:wplus_search_history_max = 100

" ─────────────────────────────────────────────────────────
" ═ 기타 모듈 설정 ═
" ─────────────────────────────────────────────────────────

" Surround (괄호/따옴표)
let g:wplus_surround_enabled = 1

" Pairs (쌍 이동)
let g:wplus_pairs_enabled = 1

" Repeat (반복 기능)
let g:wplus_repeat_enabled = 1

" Commentary (주석 토글)
let g:wplus_commentary_enabled = 1

" Indent (들여쓰기 가이드)
let g:wplus_indent_enabled = 1

" ──────────────────────────────────────────────────────────
" 키 매핑 (wplus 명령어)
" ──────────────────────────────────────────────────────────

" 1. 탐색 및 검색
nnoremap <leader>e  :WexplorerToggle<CR>      " 탐색기 토글
nnoremap <leader>p  :WfindFiles<CR>           " 파일 검색
nnoremap <leader>b  :WfindBuffers<CR>         " 버퍼 검색
nnoremap <leader>m  :WfindMRU<CR>             " 최근 파일
nnoremap <leader>fg :Wgrep <C-r><C-w><CR>    " 단어 검색
nnoremap <leader>fR :WgrepRx<CR>              " 정규표현식 검색
nnoremap <leader>fw :WgrepWord<CR>            " 단어 검색 (엄격)

" 2. LSP 기능 (기본 바인딩)
" gd   - 정의 이동
" gr   - 참조 찾기
" K    - 호버 정보
" <F2> - 이름 변경 (플러그인에서 설정)

" 3. AI Assistant
nnoremap <leader>ac :WaiComment<CR>           " 주석 생성
nnoremap <leader>ao :WaiComplete<CR>          " 코드 완성
vnoremap <leader>ar :WaiRefactor<CR>          " 리팩토링

" 4. Git 기능
nnoremap <leader>bl :BlamerToggle<CR>         " Git Blame 토글
nnoremap <leader>cn :WconflictNext<CR>        " 다음 충돌
nnoremap <leader>cp :WconflictPrev<CR>        " 이전 충돌
nnoremap <leader>co :WconflictOurs<CR>        " Ours 선택
nnoremap <leader>ct :WconflictTheirs<CR>      " Theirs 선택
nnoremap <leader>cb :WconflictBoth<CR>        " 둘 다 선택

" 5. TODO/Quickfix
nnoremap <leader>tt :WtodoQuickfix<CR>        " TODO 목록

" 6. Undo/Terminal
nnoremap <leader>u  :UndotreeToggle<CR>       " Undo tree
nnoremap <leader>tm :WplusTerminalToggle<CR>  " 터미널

" 7. 버퍼/윈도우
nnoremap <leader>bd :Bdelete<CR>              " 버퍼 삭제
nnoremap <leader>t  :TagbarToggle<CR>         " Tagbar

" 8. 윈도우 네비게이션
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" 9. 일반 편의 매핑
nnoremap <Tab>   :bnext<CR>
nnoremap <S-Tab> :bprev<CR>
nnoremap <silent> <leader>h :noh<CR>
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>Q :qa!<CR>

" ──────────────────────────────────────────────────────────
" 자동 명령
" ──────────────────────────────────────────────────────────

" 파일 열 때 마지막 커서 위치 복귀
augroup restore_cursor
    autocmd!
    autocmd BufReadPost *
        \ if line("'\"") > 1 && line("'\"") <= line("$") |
        \   exe "normal! g'\"" |
        \ endif
augroup END

" undo 디렉토리 자동 생성
let s:undodir = expand('~/.vim/undodir')
if !isdirectory(s:undodir) | call mkdir(s:undodir, 'p') | endif
