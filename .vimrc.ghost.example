" ============================================================
" vim-wplus 기반 초경량화된 .vimrc.ghost.example
" Vim Ghost Text 연동 및 wplus 모듈 최적화 설정
" ============================================================

set nocompatible
set encoding=utf-8
let mapleader = " "

" ── vim-plug 플러그인 관리 ──────────────────────────────────
call plug#begin('~/.vim/plugged')

" 메인 플러그인 (대부분의 기능을 대체함)
Plug '/home/seoyc/Workspace/utils/vim-wplus'

" --- Vim Ghost Text ---
Plug '/home/seoyc/Workspace/utils/vim-ghost-text'

" UI / 필수 도구
Plug 'morhetz/gruvbox'                  " 컬러 테마
Plug 'tpope/vim-fugitive'               " Git 명령어 통합 (:Git)
Plug 'preservim/tagbar'                 " 코드 구조 보기 (ctags 필요)
Plug 'mg979/vim-visual-multi', {'branch': 'master'}  " 멀티 커서 (선택 사항)

" 언어별 Syntax
Plug 'sheerun/vim-polyglot'

call plug#end()

" ── 기본 설정 ──────────────────────────────────────────────
syntax on
filetype plugin indent on

set fileencoding=utf-8
set fileencodings=utf-8,cp949,euc-kr,latin1
set number relativenumber
set cursorline
set signcolumn=yes

set tabstop=4 shiftwidth=4 expandtab autoindent
set hlsearch incsearch ignorecase smartcase
set hidden nobackup noswapfile
set undofile undodir=~/.vim/undodir
set scrolloff=8 sidescrolloff=8
set wrap linebreak
set clipboard=unnamedplus
set mouse=a
set wildmenu wildmode=longest:full,full
set pumheight=10
set title
set nrformats-=octal
set list listchars=tab:→\ ,trail:·,nbsp:␣
set updatetime=300 timeoutlen=500
set shortmess+=c
set splitbelow splitright
set colorcolumn=80,120

" ── 컬러 테마 ──────────────────────────────────────────────
set termguicolors
set background=dark
silent! colorscheme gruvbox

" ── 키 매핑 (wplus 핵심 기능) ──────────────────────────────

" 1. 탐색 및 검색
nnoremap <leader>e :WexplorerToggle<CR>
nnoremap <leader>p :WfindFiles<CR>
nnoremap <leader>b :WfindBuffers<CR>
nnoremap <leader>m :WfindMRU<CR>
nnoremap <leader>fg :Wgrep <C-r><C-w><CR>

" 2. 개발 도구 (LSP)
" gd / gr / K 등 wplus/lsp 자동 매핑 활용

" 3. 터미널 및 기타
nnoremap <leader>tt :WplusTerminalToggle<CR>
nnoremap <leader>u  :UndotreeToggle<CR>
nnoremap <leader>bd :Bdelete<CR>
nnoremap <leader>bl :BlamerToggle<CR>

" 4. 일반 편의 매핑
nnoremap <leader>t :TagbarToggle<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nnoremap <Tab>   :bnext<CR>
nnoremap <S-Tab> :bprev<CR>
nnoremap <silent> <leader>h :noh<CR>
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>Q :qa!<CR>

" ── 자동 명령 ──────────────────────────────────────────────

" 파일 열 때 마지막 커서 위치로 복귀
augroup restore_cursor
    autocmd!
    autocmd BufReadPost *
        \ if line("'\"") > 1 && line("'\"") <= line("$") |
        \   exe "normal! g'\"" |
        \ endif
augroup END

" ── undodir 생성 ───────────────────────────────────────────
let s:undodir = expand('~/.vim/undodir')
if !isdirectory(s:undodir) | call mkdir(s:undodir, 'p') | endif

" ============================================================
" Vim Ghost Text 설정
" ============================================================
" wplus/lsp의 Tab 자동완성과 충돌을 피하기 위해 Ghost Text 수락 키를 <C-l>로 변경
" 플러그인 로드 후 전역 Tab 매핑이 있다면 조용히 해제합니다.
autocmd VimEnter * silent! iunmap <Tab>
imap <silent><script><expr> <C-l> ghosttext#accept()
imap <C-\> <Plug>(ghost-text-dismiss)

let g:ghost_text_config = {
    \ 'AZURE_OPENAI_ENDPOINT': "https://robot-open-ai.openai.azure.com/",
    \ 'AZURE_OPENAI_KEY': 'EOAjn34ERHmwf2MGfq8roYKKSc9w1sNUEfXz0x7HwhT9GZlC2bmmJQQJ99BHACNns7RXJ3w3AAABACOGkRSR',
    \ 'AZURE_OPENAI_DEPLOYMENT_ID': 'gpt-5.4',
    \ 'AZURE_OPENAI_API_VERSION': '2025-04-01-preview'
    \ }
